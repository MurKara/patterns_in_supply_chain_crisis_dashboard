        L_ROOT["root"]:::root
        L_SEC["section"]:::section
        L_FND["foundational"]:::foundational
        L_MTH["methods"]:::methods
        L_APP["application"]:::application
        L_ADV["advanced"]:::advanced
        L_SOL["hard dep"] --> L_SOL2["target"]
        L_DSH["concept"] -.-> L_DSH2["target"]
