    CH3 -.-> CH10
    CH10 -.-> RULES
    CH2 -.-> GLOSSARY
    CH5 -.-> GLOSSARY
    CH6 -.-> GLOSSARY

    %% ===== Legend (rendered as a disconnected subgraph) =====
    subgraph LEGEND ["Legend"]
