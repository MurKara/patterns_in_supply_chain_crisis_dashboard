    CH10["<b>Ch 10</b><br/>Next Steps<br/><i>business plan · L2323</i>"]:::advanced

    RULES["<b>10 Rules</b><br/><i>distillation · L2709</i>"]:::section
    GLOSSARY["<b>Glossary</b><br/><i>A-Z reference · L2733</i>"]:::section

    %% ===== Entry edges from root =====
    ROOT --> CH1
    ROOT --> CH6
    ROOT -.-> GLOSSARY

