    CH1 --> CH2
    CH2 --> CH3
    CH2 --> CH4
    CH3 --> CH5
    CH4 --> CH5
    CH5 --> CH7
    CH6 --> CH7
    CH4 --> CH8
    CH5 --> CH8
    CH7 --> CH8
    CH7 --> CH9
