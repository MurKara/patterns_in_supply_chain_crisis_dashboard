    classDef root         fill:#e74c3c,stroke:#922b21,stroke-width:2px,color:#ffffff;
    classDef section      fill:#f39c12,stroke:#b9770e,stroke-width:1px,color:#1a1a1a;
    classDef foundational fill:#f7dc6f,stroke:#b7950b,stroke-width:1px,color:#1a1a1a;
    classDef methods      fill:#58d68d,stroke:#1e8449,stroke-width:1px,color:#0b3d1a;
