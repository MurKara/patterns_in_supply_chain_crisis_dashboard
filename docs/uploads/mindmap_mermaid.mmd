%% How to Day Trade for a Living — Andrew Aziz (2015)
%% Phase 1 dependency mindmap — portable Mermaid version.
%% Companion to `mindmap_obsidian.canvas` (visual radial layout).
%%
%% Edge conventions:
%%   -->   solid  = hard dependency (read the source before the target)
%%   -.->  dashed = conceptual link (not strictly required, but clarifies)
%%
%% Color conventions (match Obsidian canvas):
%%   root        = red     (book entry point)
%%   section     = orange  (appendix / reference)
%%   foundational= yellow  (prerequisites)
%%   methods     = green   (operational knowledge)
%%   application = teal    (synthesis / worked examples)
%%   advanced    = purple  (meta / career-level)

graph TD
    %% ===== Nodes =====
    ROOT["<b>How to Day Trade<br/>for a Living</b><br/><i>Andrew Aziz · 2015</i>"]:::root

    CH1["<b>Ch 1</b><br/>Introduction<br/><i>foundational · L254</i>"]:::foundational
    CH2["<b>Ch 2</b><br/>How Day Trading Works<br/><i>Stocks in Play · L397</i>"]:::foundational
    CH6["<b>Ch 6</b><br/>Candlesticks<br/><i>price action · L1248</i>"]:::foundational

    CH3["<b>Ch 3</b><br/>Risk &amp; Psychology<br/><i>2% · 2:1 R/R · L560</i>"]:::methods
    CH4["<b>Ch 4</b><br/>Find Stocks<br/><i>gappers · scans · L729</i>"]:::methods
    CH5["<b>Ch 5</b><br/>Tools &amp; Platforms<br/><i>DAS · L2 · VWAP · L942</i>"]:::methods
